#!/usr/bin/env bash
# abrun <binary-basename-in-/tmp> <scenario...>
#
# Give each side of an A/B the same start: apps quit, the saved layout thrown
# away (a skewed split ratio outlives everything else and manufactures overlap
# failures), the display arrangement put back (setmain writes permanently), the
# probe display detached, rift restarted on the binary under test, and only
# then the baseline built. Anything less and the comparison is between two
# piles of residue, not two builds.
set -uo pipefail
SC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$1"; shift

# `matrix` runs its scenarios once per restoration mode, and deserves the same
# controlled start as `run` -- float and tile have no display record at all, so
# a matrix run off a dirty guest is the easiest way to get a vacuous PASS.
CMD=run
if [[ "${1:-}" == "matrix" ]]; then CMD=matrix; shift; fi

# One at a time. There is a single guest, and a second run rebooting it, wiping
# layout.ron and copying a different binary over the first one's is invisible in
# both outputs: each prints its own version banner and neither says the other
# exists. A killed wrapper loop that advanced to its next iteration is enough to
# cause it.
LOCK=/tmp/rift-vm-ab.lock
if ! mkdir "$LOCK" 2>/dev/null; then
    echo "  refusing to run: another vm-ab holds $LOCK (pid $(cat "$LOCK/pid" 2>/dev/null))"
    echo "  wait for it, or remove the directory if it is stale"
    exit 2
fi
echo $$ > "$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT

# Every one-shot the harness has ever bootstrapped is still in
# ~/Library/LaunchAgents with RunAtLoad, and this script's first act is a
# reboot -- so each of them fires at the login that follows. A guest was found
# running five of them at once behind a battery, `handson.py` among them,
# dragging the same windows the scenarios were measuring. Nothing about that is
# visible in the results: they just stop repeating. Refuse rather than measure
# through it.
STRAY="$("$SC/vm-ssh" "ls ~/Library/LaunchAgents/ 2>/dev/null \
    | grep -v -e '^rift-harness.plist$' -e '^vdisp.plist$' | tr '\n' ' '")"
if [[ -n "${STRAY// /}" ]]; then
    echo "  refusing to run: stray LaunchAgents in the guest: $STRAY"
    echo "  each fires at the login this script's reboot causes; remove them first"
    exit 2
fi

# Reboot first. Desktops the scenarios create outlive everything short of one,
# and a guest with a dozen of them holding stale windows fails
# `check_frames_within_display` on windows parked far off screen -- a failure
# about the guest's history, not about the build under test.
"$SC/vm-ssh" "sudo shutdown -r now" >/dev/null 2>&1
sleep 55
for _ in $(seq 1 24); do
    OUT="$("$SC/vm-ssh" "uptime" 2>/dev/null)"
    [[ "$OUT" == *"up 1 min"* ]] && break
    sleep 10
done
sleep 55

"$SC/vm-ssh" "U=\$(id -u)
killall Safari TextEdit \"System Settings\" 2>/dev/null; sleep 4
launchctl bootout gui/\$U/vdisp 2>/dev/null
launchctl bootout gui/\$U/rift-harness 2>/dev/null; sleep 2
cp ~/rift-harness/builds/$BIN ~/rift-harness/bin/rift || exit 1
cp ~/rift-harness/builds/$BIN-cli ~/rift-harness/bin/rift-cli || exit 1
codesign --force --sign - ~/rift-harness/bin/rift ~/rift-harness/bin/rift-cli >/dev/null 2>&1
rm -f ~/.rift/layout.ron
rm -rf ~/rift-harness/traces
: > /tmp/rift.err
launchctl bootstrap gui/\$U ~/Library/LaunchAgents/rift-harness.plist
sleep 10
sudo ~/rift-harness/bin/rift sa load 2>&1 | tail -1
~/rift-harness/bin/dtool setmain 1 >/dev/null 2>&1; sleep 3
~/rift-harness/bin/rift --version | head -1"

# Printing the version is not checking it. A second vm-ab copying its own
# binary over this one leaves a run that says rift-final in its header, reports
# the other build's version four lines down, and compares the wrong pair.
WANT="$("$SC/vm-ssh" "~/rift-harness/builds/$BIN --version 2>&1 | head -1")"
GOT="$("$SC/vm-ssh" "~/rift-harness/bin/rift --version 2>&1 | head -1")"
if [[ "$WANT" != "$GOT" ]]; then
    echo "  refusing to compare: asked for $BIN ($WANT) but the guest is running $GOT"
    exit 2
fi
# Twice: the first pass opens the apps, the second tiles them once they have
# all settled onto the shown desktop.
# macOS keeps desktops across the reboot above, and every churn scenario leaves
# some behind: one night of batteries left the guest with about three hundred,
# and the same build's score drifted as the pile grew. Destroy the empty ones so
# every side starts from the same few.
GX_TIMEOUT=600 "$SC/vm-run1" "/usr/bin/python3 /Users/vm/rift-harness/prune.py" 2>&1 | grep '^prune' || true
# Destroying desktops can take Dock down with it, and so can a churn. rift
# reloads the addition by replaying `run_on_start` -- which in this guest once
# said bare `rift`, not on launchd's PATH, so every reload failed and whole
# batteries ran without the addition while still printing "loaded and healthy"
# at the top. Check again here, after the prune, and refuse rather than measure
# a build without the thing most of the scenarios depend on.
SA="$("$SC/vm-ssh" "sudo ~/rift-harness/bin/rift sa status 2>&1 | head -1")"
if [[ "$SA" != *"loaded and healthy"* ]]; then
    "$SC/vm-ssh" "sudo ~/rift-harness/bin/rift sa load >/dev/null 2>&1; sleep 3"
    SA="$("$SC/vm-ssh" "sudo ~/rift-harness/bin/rift sa status 2>&1 | head -1")"
    if [[ "$SA" != *"loaded and healthy"* ]]; then
        echo "  refusing to compare: the scripting addition is down after the prune ($SA)"
        exit 2
    fi
fi
CHAOS_TIMEOUT=200 "$SC/vm-run" normalize >/dev/null 2>&1
CHAOS_TIMEOUT=500 "$SC/vm-run" setup >/dev/null 2>&1
"$SC/vm-ssh" "killall Safari TextEdit 2>/dev/null; sleep 4"
CHAOS_TIMEOUT=500 "$SC/vm-run" setup >/dev/null 2>&1
BASE="$("$SC/vm-ssh" "grep -m1 'tiled' /tmp/chaos.log")"
echo "baseline: $BASE"
# The scenarios are written against five tiled windows. Refusing only at zero
# let a run proceed on a baseline of one -- which is what a guest still busy
# with a phantom battery hands you, and every geometry result below it is then
# about the wrong number of windows.
TILED="$(sed -n 's/.*tiled \([0-9][0-9]*\) window.*/\1/p' <<<"$BASE")"
# Four is the floor the geometry scenarios need; five is what a clean setup
# gives. Demanding five turned a short launch into a refusal, which is the
# wrong trade -- the number is printed either way, and an A/B is only
# comparable if both sides report the same one, so check that rather than
# rejecting a run that could have told you something.
if [[ -z "$TILED" || "$TILED" -lt 4 ]]; then
    echo "  refusing to compare: baseline has ${TILED:-no} tiled window(s), need at least 4"
    echo "  (a guest still running an earlier battery looks exactly like this)"
    exit 2
fi
# No `head` here. Fifteen scenarios' failure reasons do not fit in thirty
# lines, and truncating them is how a run came back with its last five reasons
# missing -- which reads exactly like five scenarios that failed silently.
CHAOS_TIMEOUT=3600 "$SC/vm-run" "$CMD" "$@" 2>&1 | sed -n '/=== matrix ===/,$p;/=== summary ===/,$p'

# And say how the addition fared during the run. A Dock crash the supervisor
# recovered from is harmless; one it could not recover from turns every result
# after it into a measurement of rift without the addition.
"$SC/vm-ssh" "L=/tmp/rift.err
echo \"scripting addition during the run: \$(grep -c 'stopped answering' \$L) Dock restart(s), \$(grep -c 'is live' \$L) load(s), \$(grep -c 'could not reload' \$L) failed reload(s)\"
sudo ~/rift-harness/bin/rift sa status 2>&1 | head -1"
